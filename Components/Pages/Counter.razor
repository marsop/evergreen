@page "/counter"
@inherits LocalizedComponentBase
<PageTitle>@T("Counter")</PageTitle>

<h1>@T("Counter")</h1>

<p role="status">@T("CurrentCount", currentCount)</p>

<button class="btn btn-primary" @onclick="IncrementCount">@T("ClickMe")</button>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
