	private List<Place> places => Garden.State.Places;
	private List<JournalEntry> journalEntries => Garden.State.JournalEntries;
	private string selectedPlantId = "";
	private string accountId = "";
	private string actionError = "";
	private bool accountBusy = true;
	private ElementReference photoInput;
	private CompressedPhoto? selectedPhoto;
	private bool photoBusy;
	private bool formSaving;
	private int photoSelection;
	private string journalEntryId = "";
	private Timer? dayTimer;
	private string activeView = "Today";
	private string selectedLocation = "All";
	private string selectedJournalType = "All";
	private string searchTerm = string.Empty;
	private Plant? selectedPlant => plants.FirstOrDefault(plant => plant.Id == selectedPlantId);
	private Plant? editingPlant;
	private int DueCount => plants.Count;
	private int WateredCount => plants.Count(plant => plant.Watered);
	private string CurrentTitle => T(activeView == "Profile" ? "PlantProfile" : activeView);
	private IEnumerable<Plant> FilteredPlants => plants
		.Where(plant => selectedLocation == "All" || plant.PlaceId == selectedLocation)
		.Where(plant => plant.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || plant.Species.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
	private IEnumerable<JournalEntry> FilteredJournal => journalEntries
		.Where(entry => selectedJournalType == "All" || entry.Type == selectedJournalType)
		.OrderByDescending(entry => entry.SortOrder);
	private bool showPlantForm;
	private bool showPlaceForm;
	private bool showJournalForm;
	private string plantNameInput = string.Empty;
	private string plantSpeciesInput = string.Empty;
	private string plantLocationInput = "";
	private string plantCategoryInput = CategoryOrder[1];
	private string placeNameInput = string.Empty;
	private string placeLightInput = "Bright, filtered";
	private string placeTemperatureInput = "20–23 °C";
	private bool placeOutdoorInput;
	private string journalTypeInput = "Watered";
	private string journalPlantInput = "Monstera";
	private string journalNoteInput = string.Empty;
	private string journalPhotoData = string.Empty;
	private string journalPhotoName = string.Empty;
	private string photoError = string.Empty;
	private string plantFormError = string.Empty;
	private string placeFormError = string.Empty;
	private string journalFormError = string.Empty;

	private string CountLabel(string key, int count) => T(key + (count == 1 ? "One" : "Many"), count);
	private string JournalDate(DateOnly? date) => date?.ToString(T("JournalDateFormat"), Cultures.Culture) ?? T("Today");
	private string JournalPlantName(JournalEntry entry) => plants.FirstOrDefault(plant => plant.Id == entry.PlantId)?.Name ?? entry.PlantName;
	private string JournalTitle(JournalEntry entry) => T(entry.TitleKey, JournalPlantName(entry));
	private string JournalDescription(JournalEntry entry) => entry.UserNote
		?? (entry.DescriptionKey == "WateringDescription"
			? T(entry.DescriptionKey, JournalPlantName(entry), T(entry.WaterAmount))
			: T(entry.DescriptionKey, JournalPlantName(entry)));
	private string PlaceTemperature(Place place) => place.TemperatureKey is null ? place.Temperature : T(place.TemperatureKey);

	private bool IsCurrent(string name) => activeView == name || (activeView == "Profile" && name == "Plants");
	private void Navigate(string view) => activeView = view;
	private void SetJournalFilter(string entryType) => selectedJournalType = selectedJournalType == entryType ? "All" : entryType;

	private void OpenPlant(Plant plant)
	{
		selectedPlantId = plant.Id;
		activeView = "Profile";
	}

	private void ShowPlacePlants(string placeName)
	{
		selectedLocation = placeName;
		activeView = "Plants";
	}

	private async Task ToggleWater(Plant plant)
	{
		var id = GardenSnapshot.WateringId(plant.Id, SampleToday);
		var entry = new JournalEntry("JournalWateredTitle", "WateringDescription", "Watered", SampleToday,
			DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), WaterAmount: plant.WaterAmount) { Id = id, PlantId = plant.Id };
		await RunAction(() => Garden.SaveAsync(new GardenWrite("journalEntries", id, plant.Watered ? null : entry, plant.Watered)));
	}

	private void OpenPlantForm()
	{
		editingPlant = null;
		plantNameInput = string.Empty;
		plantSpeciesInput = string.Empty;
		plantLocationInput = (places.FirstOrDefault(place => !place.Outdoor) ?? places[0]).Id;
		plantCategoryInput = CategoryOrder[1];
		plantFormError = string.Empty;
		showPlantForm = true;
	}

	private void OpenEditPlantForm()
	{
		if (selectedPlant is null) return;
		editingPlant = selectedPlant;
		plantNameInput = selectedPlant.Name;
		plantSpeciesInput = selectedPlant.Species;
		plantLocationInput = selectedPlant.PlaceId;
		plantCategoryInput = selectedPlant.Category;
		plantFormError = string.Empty;
		showPlantForm = true;
	}

	private async Task SavePlant()
	{
		if (string.IsNullOrWhiteSpace(plantNameInput))
		{
			plantFormError = "PlantNameRequired";
			return;
		}
		if (editingPlant is null)
		{
			var plant = new Plant(plantNameInput.Trim(), string.IsNullOrWhiteSpace(plantSpeciesInput) ? plantNameInput.Trim() : plantSpeciesInput.Trim(), "", plantCategoryInput, "Small", "Bright", string.Empty)
				{ PlaceId = plantLocationInput };
			if (!await RunAction(() => Garden.SaveAsync(new GardenWrite("plants", plant.Id, plant)))) return;
		}
		else
		{
			var fields = new Dictionary<string, object>();
			if (editingPlant.Name != plantNameInput.Trim()) fields["name"] = plantNameInput.Trim();
			var species = string.IsNullOrWhiteSpace(plantSpeciesInput) ? plantNameInput.Trim() : plantSpeciesInput.Trim();
			if (editingPlant.Species != species) fields["species"] = species;
			var placeId = plantLocationInput;
			if (editingPlant.PlaceId != placeId) fields["placeId"] = placeId;
			if (editingPlant.Category != plantCategoryInput) fields["category"] = plantCategoryInput;
			if (fields.Count > 0 && !await RunAction(() => Garden.SaveAsync(new GardenWrite("plants", editingPlant.Id, fields)))) return;
		}
		CloseForms();
	}

	private void OpenPlaceForm()
	{
		placeNameInput = string.Empty;
		placeLightInput = "Bright, filtered";
		placeTemperatureInput = "20–23 °C";
		placeOutdoorInput = false;
		placeFormError = string.Empty;
		showPlaceForm = true;
	}

	private async Task SavePlace()
	{
		if (string.IsNullOrWhiteSpace(placeNameInput))
		{
			placeFormError = "PlaceNameRequired";
			return;
		}
		if (places.Any(place => place.Name.Equals(placeNameInput.Trim(), StringComparison.OrdinalIgnoreCase)))
		{
			placeFormError = "PlaceNameDuplicate";
			return;
		}
		var place = new Place(placeNameInput.Trim(), placeLightInput, placeTemperatureInput, placeOutdoorInput, string.Empty);
		if (!await RunAction(() => Garden.SaveAsync(new GardenWrite("places", place.Id, place)))) return;
		CloseForms();
	}

	private void OpenJournalForm()
	{
		journalTypeInput = "Watered";
		journalPlantInput = plants.FirstOrDefault(plant => plant.Name == "Monstera")?.Id ?? plants[0].Id;
		journalEntryId = Guid.NewGuid().ToString("N");
		selectedPhoto = null;
		journalNoteInput = string.Empty;
		journalPhotoData = string.Empty;
		journalPhotoName = string.Empty;
		photoError = string.Empty;
		journalFormError = string.Empty;
		showJournalForm = true;
	}

	private async Task HandlePhotoSelected(ChangeEventArgs eventArgs)
	{
		var selection = ++photoSelection;
		var account = Garden.State.Uid;
		var entryId = journalEntryId;
		photoBusy = true;
		journalPhotoData = string.Empty;
		journalPhotoName = string.Empty;
		selectedPhoto = null;
		try
		{
			var compressed = await Garden.CompressPhotoAsync(photoInput);
			if (selection != photoSelection || account != Garden.State.Uid || entryId != journalEntryId) return;
			selectedPhoto = compressed;
			journalPhotoData = "data:image/jpeg;base64," + selectedPhoto.Payload;
			photoError = string.Empty;
		}
		catch (JSException)
		{
			if (selection == photoSelection) photoError = "PhotoCompressionFailed";
		}
		finally { if (selection == photoSelection) photoBusy = false; }
	}

	private async Task SaveJournalEntry()
	{
		if (journalTypeInput == "Photo" && photoError.Length > 0)
		{
			journalFormError = "PhotoCompressionFailed";
			return;
		}
		if (string.IsNullOrWhiteSpace(journalPlantInput))
		{
			journalFormError = "JournalPlantRequired";
			return;
		}
		var titleKey = "Journal" + journalTypeInput + "Title";
		var note = string.IsNullOrWhiteSpace(journalNoteInput) ? null : journalNoteInput.Trim();
		var photo = journalTypeInput == "Photo" ? selectedPhoto : null;
		var entry = new JournalEntry(titleKey, titleKey, journalTypeInput, SampleToday, DateTimeOffset.UtcNow.ToUnixTimeMilliseconds(), UserNote: note)
			{ Id = journalEntryId, PlantId = journalPlantInput, PhotoId = photo is null ? "" : journalEntryId };
		var writes = new List<GardenWrite> { new("journalEntries", entry.Id, entry) };
		if (photo is not null) writes.Add(new GardenWrite("photos", entry.PhotoId, photo));
		if (!await RunAction(() => Garden.SaveAsync(writes.ToArray()))) return;
		CloseForms();
	}

	private void CloseForms()
	{
		showPlantForm = false;
		showPlaceForm = false;
		showJournalForm = false;
		editingPlant = null;
		photoSelection++;
		photoBusy = false;
		selectedPhoto = null;
		journalPhotoData = "";
	}

	private async Task SaveForm(Func<Task> save)
	{
		if (formSaving) return;
		formSaving = true;
		try { await save(); }
		finally { formSaving = false; }
	}

	private static IconName JournalIcon(string type) => type switch
	{
		"Watered" => IconName.Water,
		"Fertilized" => IconName.Fertilizer,
		"Repotted" => IconName.Repot,
		"Pruned" => IconName.Prune,
		"Treated" => IconName.Treatment,
		"Photo" => IconName.Photo,
		_ => IconName.Leaf
	};

	protected override async Task OnInitializedAsync()
	{
		Garden.Changed += OnGardenChanged;
		try { await Garden.InitializeAsync(GardenSamples.Create()); }
		catch (JSException) { actionError = "FirebaseSetupRequired"; }
		finally { accountBusy = false; }
		dayTimer = new Timer(_ => InvokeAsync(() =>
		{
			Garden.State.ResolveRelationships(SampleToday);
			StateHasChanged();
		}), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
	}

	private void OnGardenChanged()
	{
		if (accountId != Garden.State.Uid)
		{
			accountId = Garden.State.Uid;
			CloseForms();
			activeView = "Today";
			selectedPlantId = "";
			selectedLocation = "All";
			selectedJournalType = "All";
			searchTerm = "";
			selectedPhoto = null;
			journalPhotoData = "";
		}
		_ = InvokeAsync(StateHasChanged);
	}

	private async Task<bool> RunAction(Func<Task> action)
	{
		actionError = "";
		try { await action(); return true; }
		catch (JSException) { actionError = "SaveFailed"; return false; }
	}

	private async Task SignIn()
	{
		accountBusy = true;
		await RunAction(Garden.SignInAsync);
		accountBusy = false;
	}

	private async Task SignOut()
	{
		accountBusy = true;
		await RunAction(Garden.SignOutAsync);
		accountBusy = false;
	}

	private async Task Retry() => await RunAction(Garden.RetryAsync);
	public void Dispose()
	{
		Garden.Changed -= OnGardenChanged;
		dayTimer?.Dispose();
	}
}
