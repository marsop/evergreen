@page "/"
@inherits LocalizedComponentBase
<PageTitle>@T("PlantCareTitle")</PageTitle>

<div class="app-shell">
	<aside class="sidebar" aria-label="@T("MainNavigation")">
		<a class="brand" href="" aria-label="@T("EvergreenHome")">
			<span class="brand-mark" aria-hidden="true">e</span>
			<span><strong>Evergreen</strong><small>@T("BrandTagline")</small></span>
		</a>

		<div class="nav-label">@T("YourGarden")</div>
		<nav class="primary-nav">
			@foreach (var item in NavigationItems)
			{
				<button class="nav-item @(IsCurrent(item.Name) ? "active" : "")" @onclick="() => Navigate(item.Name)">
					<span class="nav-icon" aria-hidden="true">@item.Icon</span>
					<span>@T(item.Name)</span>
					@if (item.Name == "Today")
					{
						<span class="nav-count">@DueCount</span>
					}
				</button>
			}
		</nav>

		<div class="sidebar-bottom">
			<div class="season-card">
				<span class="season-mark" aria-hidden="true">✳</span>
				<div><strong>@T("WinterRhythm")</strong><span>@T("WinterFeed")</span></div>
			</div>
			<div class="sidebar-foot"><span class="status-dot"></span> @T("GardenCounts", CountLabel("PlantCount", plants.Count), CountLabel("PlaceCount", places.Count))</div>
		</div>
	</aside>

	<main class="main-area">
		<header class="topbar">
			<div class="breadcrumbs"><span>@T("YourGarden")</span><span class="crumb-separator">/</span><strong>@CurrentTitle</strong></div>
			<div class="topbar-actions">
				<span class="today-date">@SampleToday.ToString(T("DashboardDateFormat"), Cultures.Culture)</span>
				<LanguageSelector />
				<button class="button button-dark" @onclick="OpenJournalForm"><span aria-hidden="true">+</span> @T("LogCare")</button>
			</div>
		</header>

		@if (activeView == "Today")
		{
			<section class="view-content today-view">
				<div class="today-heading">
					<div>
						<p class="eyebrow">@SampleToday.ToString(T("DashboardDateFormat"), Cultures.Culture).ToUpper(Cultures.Culture) <span class="eyebrow-dot"></span> @T("WateringDay")</p>
						<h1>@T("TodayHeading")</h1>
						<p class="lead">@T("TodayLead")</p>
					</div>
					<div class="day-progress" aria-label="@T("WateringProgress", WateredCount, plants.Count)">
						<div class="progress-ring"><span>@WateredCount<small>/@plants.Count</small></span></div>
						<span>@T("WateredToday")</span>
					</div>
				</div>

				<div class="today-banner">
					<div class="banner-icon" aria-hidden="true">✳</div>
					<div><strong>@T("WinterRhythm")</strong><span>@T("WinterFertilizing")</span></div>
					<span class="banner-note">@T("SeasonRoutine")</span>
				</div>

				<div class="section-heading task-heading">
					<div><p class="eyebrow">@T("CareList")</p><h2>@CountLabel("ThingsToday", DueCount)</h2></div>
					<button class="text-button" @onclick='() => Navigate("Plants")'>@T("ViewAllPlants") <span aria-hidden="true">→</span></button>
				</div>

				<div class="task-locations">
					@foreach (var locationGroup in plants.GroupBy(plant => plant.Location))
					{
						<section class="task-location">
							<div class="location-heading"><span class="location-pin" aria-hidden="true">⌖</span><h3>@locationGroup.Key</h3><span>@CountLabel("PlantCount", locationGroup.Count())</span></div>
							<div class="task-list">
								@foreach (var plant in locationGroup)
								{
									<article class="task-row @(plant.Watered ? "is-watered" : "")">
										<button class="task-plant" @onclick="() => OpenPlant(plant)" aria-label="@T("OpenPlantProfile", plant.Name)">
											<span class="plant-thumb small-thumb">
												@if (!string.IsNullOrWhiteSpace(plant.Image)) { <img src="@plant.Image" alt="" /> }
												else { <span aria-hidden="true">✿</span> }
											</span>
											<span class="task-copy"><strong>@plant.Name</strong><small>@T("WaterSchedule", T(plant.WaterAmount))</small></span>
										</button>
										<button class="water-button @(plant.Watered ? "done" : "")" @onclick="() => ToggleWater(plant)" aria-label="@T(plant.Watered ? "UndoWatering" : "MarkWatered", plant.Name)">
											<span aria-hidden="true">@(plant.Watered ? "✓" : "↓")</span> @T(plant.Watered ? "Watered" : "Water")
										</button>
									</article>
								}
							</div>
						</section>
					}
				</div>

				<section class="week-strip">
					<div class="section-heading"><div><p class="eyebrow">@T("AheadOfYou")</p><h2>@T("NextSevenDays")</h2></div><span class="muted-copy">@T("WeekPreview")</span></div>
					<div class="week-days">
						@foreach (var day in WeekDays)
						{
							<div class="week-day @(day.Day == DayOfWeek.Sunday ? "current" : "")"><span>@Cultures.Culture.DateTimeFormat.GetAbbreviatedDayName(day.Day)</span><strong>@day.Count</strong></div>
						}
					</div>
				</section>
			</section>
		}
		else if (activeView == "Plants")
		{
			<section class="view-content">
				<div class="page-heading">
					<div><p class="eyebrow">@T("YourCollection")</p><h1>@T("Plants") <span class="heading-count">@plants.Count</span></h1><p class="lead">@T("PlantsLead")</p></div>
					<button class="button button-dark" @onclick="OpenPlantForm"><span aria-hidden="true">+</span> @T("AddPlant")</button>
				</div>
				<div class="toolbar">
					<label class="search-box"><span aria-hidden="true">⌕</span><input aria-label="@T("SearchPlants")" placeholder="@CountLabel("SearchPlantCount", plants.Count)" @bind="searchTerm" @bind:event="oninput" /></label>
					<div class="filter-row" role="group" aria-label="@T("FilterByPlace")">
						@foreach (var placeName in new[] { "All" }.Concat(places.Select(place => place.Name)))
						{
							<button class="filter-chip @(selectedLocation == placeName ? "selected" : "")" @onclick="() => selectedLocation = placeName">@(placeName == "All" ? T("All") : placeName)</button>
						}
					</div>
				</div>
				@if (!FilteredPlants.Any())
				{
					<div class="empty-state"><span aria-hidden="true">✿</span><h2>@T("NoPlantsFound")</h2><p>@T("TryDifferentSearch")</p></div>
				}
				else
				{
					<div class="plant-groups">
						@foreach (var group in FilteredPlants.GroupBy(plant => plant.Category).OrderBy(group => CategoryOrder.IndexOf(group.Key)))
						{
							<section class="plant-group">
								<div class="group-title"><h2>@T(group.Key)</h2><span>@group.Count().ToString("00", Cultures.Culture)</span></div>
								<div class="plant-list">
									@foreach (var plant in group)
									{
										<button class="plant-list-row" @onclick="() => OpenPlant(plant)">
											<span class="plant-thumb">
												@if (!string.IsNullOrWhiteSpace(plant.Image)) { <img src="@plant.Image" alt="" /> }
												else { <span aria-hidden="true">✿</span> }
											</span>
											<span class="plant-name"><strong>@plant.Name</strong><small>@plant.Location</small></span>
											<span class="sun-label"><span aria-hidden="true">☼</span> @T(plant.Light)</span>
											<span class="row-arrow" aria-hidden="true">↗</span>
										</button>
									}
								</div>
							</section>
						}
					</div>
				}
			</section>
		}
		else if (activeView == "Places")
		{
			<section class="view-content">
				<div class="page-heading">
					<div><p class="eyebrow">@T("LightMakesHome")</p><h1>@T("Places")</h1><p class="lead">@T("PlacesLead")</p></div>
					<button class="button button-dark" @onclick="OpenPlaceForm"><span aria-hidden="true">+</span> @T("AddPlace")</button>
				</div>
				<h2 class="subsection-title">@T("Indoor") <span>@CountLabel("SpotCount", places.Count(place => !place.Outdoor))</span></h2>
				<div class="place-grid">
					@foreach (var place in places.Where(place => !place.Outdoor))
					{
						<button class="place-card" @onclick="() => ShowPlacePlants(place.Name)">
							<div class="place-card-top"><span class="place-symbol" aria-hidden="true">⌂</span><span class="plant-count">@CountLabel("PlantCount", plants.Count(plant => plant.Location == place.Name))</span></div>
							<h3>@place.Name</h3>
							<div class="place-facts"><span><b aria-hidden="true">☼</b> @T(place.Light)</span><span><b aria-hidden="true">°</b> @PlaceTemperature(place)</span></div>
							<div class="place-leaves">
								@foreach (var plant in plants.Where(plant => plant.Location == place.Name).Take(4))
								{
									<span class="plant-thumb mini-thumb">@if (!string.IsNullOrWhiteSpace(plant.Image)) { <img src="@plant.Image" alt="" /> } else { <span aria-hidden="true">✿</span> }</span>
								}
							</div>
							@if (place.Note.Length > 0) { <p class="place-note">@T(place.Note)</p> }
						</button>
					}
				</div>
				<h2 class="subsection-title outdoor-title">@T("Outdoor") <span>@T("LetWeatherIn")</span></h2>
				<div class="outdoor-row">
					@foreach (var place in places.Where(place => place.Outdoor))
					{
						<button class="place-card outdoor-card" @onclick="() => ShowPlacePlants(place.Name)">
							<div class="place-card-top"><span class="place-symbol" aria-hidden="true">☼</span><span class="plant-count">@CountLabel("PlantCount", plants.Count(plant => plant.Location == place.Name))</span></div>
							<h3>@place.Name</h3><div class="place-facts"><span><b aria-hidden="true">☼</b> @T(place.Light)</span><span><b aria-hidden="true">°</b> @PlaceTemperature(place)</span></div>
						</button>
						@if (place.Name == "Garden")
						{
							<button class="add-place-card" @onclick="OpenPlaceForm"><span aria-hidden="true">+</span><span>@T("AddOutdoorPlace")</span></button>
						}
					}
				</div>
			</section>
		}
		else if (activeView == "Journal")
		{
			<section class="view-content">
				<div class="page-heading">
					<div><p class="eyebrow">@T("NotesFromGarden")</p><h1>@T("Journal")</h1><p class="lead">@T("JournalLead")</p></div>
					<button class="button button-dark" @onclick="OpenJournalForm"><span aria-hidden="true">+</span> @T("AddEntry")</button>
				</div>
				<div class="journal-filters" role="group" aria-label="@T("FilterJournal")">
					@foreach (var entryType in JournalTypes)
					{
						<button class="journal-filter @(selectedJournalType == entryType ? "selected" : "")" @onclick="() => SetJournalFilter(entryType)">
							<span aria-hidden="true">@JournalIcon(entryType)</span>@T(entryType)
						</button>
					}
					<button class="journal-filter @(selectedJournalType == "All" ? "selected" : "")" @onclick='() => selectedJournalType = "All"'>@T("All")</button>
				</div>
				<div class="journal-timeline">
					@foreach (var day in FilteredJournal.GroupBy(entry => entry.Date))
					{
						<section class="journal-day"><h2>@JournalDate(day.Key)</h2>
							@foreach (var entry in day)
							{
								<article class="journal-entry"><span class="journal-entry-icon" aria-hidden="true">@JournalIcon(entry.Type)</span><div><strong>@JournalTitle(entry)</strong><p>@JournalDescription(entry)</p>@if (!string.IsNullOrWhiteSpace(entry.PhotoData)) { <img class="journal-photo" src="@entry.PhotoData" alt="@T("JournalAttachment")" /> }</div><time>@T(entry.Type)</time></article>
							}
						</section>
					}
					@if (!FilteredJournal.Any()) { <div class="empty-state"><span aria-hidden="true">✿</span><h2>@T("FreshPage")</h2><p>@T("CareNotesHere")</p></div> }
				</div>
			</section>
		}
		else
		{
			<section class="view-content profile-view">
				<div class="profile-back-row"><button class="back-button" @onclick='() => Navigate("Plants")'>← <span>@T("BackToPlants")</span></button><button class="text-button" @onclick="OpenEditPlantForm">@T("EditPlant") <span aria-hidden="true">↗</span></button></div>
				<div class="profile-hero">
					<div class="profile-photo">
						@if (!string.IsNullOrWhiteSpace(selectedPlant.Image)) { <img src="@selectedPlant.Image" alt="@selectedPlant.Species" /> }
						else { <span aria-hidden="true">✿</span> }
					</div>
					<div class="profile-title"><p class="eyebrow">@selectedPlant.Location <span class="eyebrow-dot"></span> @T(selectedPlant.Category)</p><h1>@selectedPlant.Name</h1><p class="species">@selectedPlant.Species</p><span class="profile-alert">⚘ <span>@T("ProfileAlert")</span></span></div>
				</div>
				<section class="care-chart"><div class="care-chart-head"><div><p class="eyebrow">@T("SeasonalCare")</p><h2>@T("CareThroughYear")</h2></div><div class="chart-legend"><span><i class="legend-water"></i>@T("Water")</span><span><i class="legend-feed"></i>@T("Fertilize")</span></div></div><div class="month-chart">
					@foreach (var month in Months)
					{
						<div class="month-column"><span class="month-bar water-bar" style="--bar: @(month.WaterHeight)" title="@T("WaterAmountTooltip", month.WaterHeight)"></span><span class="month-bar feed-bar" style="--bar: @(month.FeedHeight)" title="@T("FertilizerTooltip", month.FeedHeight)"></span><small title="@Cultures.Culture.DateTimeFormat.GetMonthName(month.Number)">@Cultures.Culture.DateTimeFormat.GetAbbreviatedMonthName(month.Number)</small></div>
					}
				</div></section>
				<div class="profile-details">
					<section class="care-cards">
						@foreach (var care in CareDetails)
						{
							<article class="care-card"><span class="care-icon" aria-hidden="true">@care.Icon</span><div><div class="care-card-title"><h3>@T(care.Title)</h3><strong>@T(care.Value)</strong></div><p>@T(care.Description)</p></div></article>
						}
					</section>
					<aside class="watchout-panel"><p class="eyebrow">@T("ThingsToWatch")</p><h2>@T("WatchOutFor")</h2><ul><li><strong>@T("YellowLeaves")</strong><span>@T("YellowLeavesAdvice")</span></li><li><strong>@T("BrownEdges")</strong><span>@T("BrownEdgesAdvice")</span></li><li><strong>@T("SpiderMites")</strong><span>@T("SpiderMitesAdvice")</span></li><li><strong>@T("Thrips")</strong><span>@T("ThripsAdvice")</span></li></ul></aside>
				</div>
				<section class="profile-history"><div class="section-heading"><div><p class="eyebrow">@T("LifeLogged")</p><h2>@T("RecentHistory")</h2></div><button class="text-button" @onclick='() => Navigate("Journal")'>@T("OpenJournal") <span aria-hidden="true">→</span></button></div>
					@foreach (var entry in journalEntries.Where(entry => JournalPlantName(entry) == selectedPlant.Name).Take(4))
					{
						<div class="history-row"><span class="journal-entry-icon" aria-hidden="true">@JournalIcon(entry.Type)</span><strong>@JournalTitle(entry)</strong><time>@JournalDate(entry.Date)</time></div>
					}
				</section>
			</section>
		}
	</main>
</div>

<nav class="mobile-nav" aria-label="@T("MobileNavigation")">
	@foreach (var item in NavigationItems)
	{
		<button class="mobile-nav-item @(IsCurrent(item.Name) ? "active" : "")" @onclick="() => Navigate(item.Name)"><span aria-hidden="true">@item.Icon</span>@T(item.Name)</button>
	}
</nav>

@if (showPlantForm)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="plant-modal-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("YourCollection")</p><h2 id="plant-modal-title">@T(editingPlant is null ? "AddAPlant" : "EditPlant")</h2></div><LanguageSelector /><button class="close-button" aria-label="@T("Close")" @onclick="CloseForms">×</button></div>
			<form novalidate @onsubmit="SavePlant" @onsubmit:preventDefault>
				<label>@T("PlantName")<input required maxlength="60" @bind="plantNameInput" placeholder="@T("PlantNameExample")" /></label>
				<label>@T("BotanicalName")<input maxlength="80" @bind="plantSpeciesInput" placeholder="@T("BotanicalNameExample")" /></label>
				<div class="form-row"><label>@T("Place")<select @bind="plantLocationInput">@foreach (var place in places) { <option value="@place.Name">@place.Name</option> }</select></label><label>@T("CareGroup")<select @bind="plantCategoryInput">@foreach (var category in CategoryOrder) { <option value="@category">@T(category)</option> }</select></label></div>
				@if (plantFormError.Length > 0) { <p class="form-error" role="alert">@T(plantFormError)</p> }
				<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CloseForms">@T("Cancel")</button><button type="submit" class="button button-dark">@T(editingPlant is null ? "AddPlant" : "SaveChanges")</button></div>
			</form>
		</section>
	</div>
}

@if (showPlaceForm)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="place-modal-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("MakeRoomToGrow")</p><h2 id="place-modal-title">@T("AddAPlace")</h2></div><LanguageSelector /><button class="close-button" aria-label="@T("Close")" @onclick="CloseForms">×</button></div>
			<form novalidate @onsubmit="SavePlace" @onsubmit:preventDefault>
				<label>@T("PlaceName")<input required maxlength="50" @bind="placeNameInput" placeholder="@T("PlaceNameExample")" /></label>
				<div class="form-row"><label>@T("Light")<select @bind="placeLightInput">@foreach (var light in PlaceLights) { <option value="@light">@T(light)</option> }</select></label><label>@T("Temperature")<input maxlength="30" @bind="placeTemperatureInput" placeholder="20–23 °C" /></label></div>
				<label class="check-label"><input type="checkbox" @bind="placeOutdoorInput" /> @T("OutdoorPlace")</label>
				@if (placeFormError.Length > 0) { <p class="form-error" role="alert">@T(placeFormError)</p> }
				<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CloseForms">@T("Cancel")</button><button type="submit" class="button button-dark">@T("AddPlace")</button></div>
			</form>
		</section>
	</div>
}

@if (showJournalForm)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="journal-modal-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("MomentInGarden")</p><h2 id="journal-modal-title">@T("LogPlantCare")</h2></div><LanguageSelector /><button class="close-button" aria-label="@T("Close")" @onclick="CloseForms">×</button></div>
			<form @onsubmit="SaveJournalEntry" @onsubmit:preventDefault>
				<label>@T("WhatHappened")<select @bind="journalTypeInput">@foreach (var type in JournalTypes) { <option value="@type">@T(type)</option> }</select></label>
				<label>@T("Plant")<select @bind="journalPlantInput">@foreach (var plant in plants) { <option value="@plant.Name">@plant.Name</option> }</select></label>
				@if (journalTypeInput == "Photo")
				{
					<label class="photo-upload"><span>@T("Photo")</span><span class="file-picker">@T("ChoosePhoto")</span><InputFile class="visually-hidden" aria-label="@T("ChoosePhoto")" accept="image/*" OnChange="HandlePhotoSelected" /><span>@(journalPhotoName.Length > 0 ? journalPhotoName : T("NoPhotoSelected"))</span></label>
					@if (!string.IsNullOrWhiteSpace(photoError)) { <p class="form-error" role="alert">@T(photoError)</p> }
					@if (!string.IsNullOrWhiteSpace(journalPhotoData)) { <img class="photo-preview" src="@journalPhotoData" alt="@T("SelectedJournalPhoto")" /> }
				}
				<label>@T("Note")<textarea rows="3" maxlength="240" @bind="journalNoteInput" placeholder="@T("NotePlaceholder")"></textarea></label>
				@if (journalFormError.Length > 0) { <p class="form-error" role="alert">@T(journalFormError)</p> }
				<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CloseForms">@T("Cancel")</button><button type="submit" class="button button-dark">@T("SaveEntry")</button></div>
			</form>
		</section>
	</div>
}

@code {
	private static readonly DateOnly SampleToday = new(2026, 10, 18);
	private static readonly string[] CategoryOrder = ["Succulents & dry", "Tropical, let top dry", "Tropical, evenly moist", "Mediterranean"];
	private static readonly string[] JournalTypes = ["Watered", "Fertilized", "Repotted", "Pruned", "Treated", "Photo"];
	private static readonly string[] PlaceLights = ["Bright, filtered", "Direct afternoon sun", "Full sun", "Low light", "Full sun to shade"];
	private static readonly (string Name, string Icon)[] NavigationItems = [("Today", "◷"), ("Plants", "♧"), ("Places", "⌂"), ("Journal", "▤")];
	private static readonly (DayOfWeek Day, string Count)[] WeekDays = [(DayOfWeek.Monday, "·"), (DayOfWeek.Tuesday, "·"), (DayOfWeek.Wednesday, "·"), (DayOfWeek.Thursday, "·"), (DayOfWeek.Friday, "·"), (DayOfWeek.Saturday, "·"), (DayOfWeek.Sunday, "23")];
	private static readonly (int Number, int WaterHeight, int FeedHeight)[] Months = [(1, 34, 0), (2, 36, 0), (3, 42, 18), (4, 52, 34), (5, 68, 43), (6, 78, 48), (7, 86, 50), (8, 78, 46), (9, 66, 30), (10, 52, 8), (11, 38, 0), (12, 34, 0)];
	private static readonly (string Icon, string Title, string Value, string Description)[] CareDetails =
	[
		("☼", "Light", "CareLightValue", "CareLightAdvice"),
		("↓", "Water", "CareWaterValue", "CareWaterAdvice"),
		("✳", "Fertilizer", "CareFeedValue", "CareFeedAdvice"),
		("°", "TemperatureHumidity", "CareTemperatureValue", "CareTemperatureAdvice"),
		("▧", "SubstrateRepotting", "CareRepotValue", "CareRepotAdvice"),
		("✂", "Pruning", "CarePruningValue", "CarePruningAdvice"),
		("♧", "Propagation", "CarePropagationValue", "CarePropagationAdvice")
	];

	private readonly List<Plant> plants = CreatePlants();
	private readonly List<Place> places = CreatePlaces();
	private readonly List<JournalEntry> journalEntries = CreateJournalEntries();
	private string activeView = "Today";
	private string selectedLocation = "All";
	private string selectedJournalType = "All";
	private string searchTerm = string.Empty;
	private Plant selectedPlant => plants.First(plant => plant.IsSelected);
	private Plant? editingPlant;
	private int DueCount => plants.Count;
	private int WateredCount => plants.Count(plant => plant.Watered);
	private string CurrentTitle => T(activeView == "Profile" ? "PlantProfile" : activeView);
	private IEnumerable<Plant> FilteredPlants => plants
		.Where(plant => selectedLocation == "All" || plant.Location == selectedLocation)
		.Where(plant => plant.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || plant.Species.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
	private IEnumerable<JournalEntry> FilteredJournal => journalEntries
		.Where(entry => selectedJournalType == "All" || entry.Type == selectedJournalType)
		.OrderByDescending(entry => entry.SortOrder);
	private bool showPlantForm;
	private bool showPlaceForm;
	private bool showJournalForm;
	private string plantNameInput = string.Empty;
	private string plantSpeciesInput = string.Empty;
	private string plantLocationInput = "Mos Eisley South";
	private string plantCategoryInput = CategoryOrder[1];
	private string placeNameInput = string.Empty;
	private string placeLightInput = "Bright, filtered";
	private string placeTemperatureInput = "20–23 °C";
	private bool placeOutdoorInput;
	private string journalTypeInput = "Watered";
	private string journalPlantInput = "Monstera";
	private string journalNoteInput = string.Empty;
	private string journalPhotoData = string.Empty;
	private string journalPhotoName = string.Empty;
	private string photoError = string.Empty;
	private string plantFormError = string.Empty;
	private string placeFormError = string.Empty;
	private string journalFormError = string.Empty;

	private string CountLabel(string key, int count) => T(key + (count == 1 ? "One" : "Many"), count);
	private string JournalDate(DateOnly? date) => date?.ToString(T("JournalDateFormat"), Cultures.Culture) ?? T("Today");
	private string JournalPlantName(JournalEntry entry) => entry.WateredPlant?.Name ?? entry.PlantName;
	private string JournalTitle(JournalEntry entry) => T(entry.TitleKey, JournalPlantName(entry));
	private string JournalDescription(JournalEntry entry) => entry.UserNote
		?? (entry.DescriptionKey == "WateringDescription"
			? T(entry.DescriptionKey, JournalPlantName(entry), T(entry.WaterAmount))
			: T(entry.DescriptionKey, JournalPlantName(entry)));
	private string PlaceTemperature(Place place) => place.TemperatureKey is null ? place.Temperature : T(place.TemperatureKey);

	private bool IsCurrent(string name) => activeView == name || (activeView == "Profile" && name == "Plants");
	private void Navigate(string view) => activeView = view;
	private void SetJournalFilter(string entryType) => selectedJournalType = selectedJournalType == entryType ? "All" : entryType;

	private void OpenPlant(Plant plant)
	{
		foreach (var item in plants) item.IsSelected = item == plant;
		activeView = "Profile";
	}

	private void ShowPlacePlants(string placeName)
	{
		selectedLocation = placeName;
		activeView = "Plants";
	}

	private void ToggleWater(Plant plant)
	{
		plant.Watered = !plant.Watered;
		if (plant.Watered)
		{
			journalEntries.Insert(0, new JournalEntry("JournalWateredTitle", "WateringDescription", "Watered", null, DateTime.UtcNow.Ticks, plant.Name, WateredPlant: plant, WaterAmount: plant.WaterAmount));
		}
		else
		{
			var entry = journalEntries.FirstOrDefault(item => item.Type == "Watered" && item.WateredPlant == plant && item.Date is null);
			if (entry is not null) journalEntries.Remove(entry);
		}
	}

	private void OpenPlantForm()
	{
		editingPlant = null;
		plantNameInput = string.Empty;
		plantSpeciesInput = string.Empty;
		plantLocationInput = places.First(place => !place.Outdoor).Name;
		plantCategoryInput = CategoryOrder[1];
		plantFormError = string.Empty;
		showPlantForm = true;
	}

	private void OpenEditPlantForm()
	{
		editingPlant = selectedPlant;
		plantNameInput = selectedPlant.Name;
		plantSpeciesInput = selectedPlant.Species;
		plantLocationInput = selectedPlant.Location;
		plantCategoryInput = selectedPlant.Category;
		plantFormError = string.Empty;
		showPlantForm = true;
	}

	private void SavePlant()
	{
		if (string.IsNullOrWhiteSpace(plantNameInput))
		{
			plantFormError = "PlantNameRequired";
			return;
		}
		if (editingPlant is null)
		{
			plants.Add(new Plant(plantNameInput.Trim(), string.IsNullOrWhiteSpace(plantSpeciesInput) ? plantNameInput.Trim() : plantSpeciesInput.Trim(), plantLocationInput, plantCategoryInput, "Small", "Bright", string.Empty));
		}
		else
		{
			editingPlant.Name = plantNameInput.Trim();
			editingPlant.Species = string.IsNullOrWhiteSpace(plantSpeciesInput) ? plantNameInput.Trim() : plantSpeciesInput.Trim();
			editingPlant.Location = plantLocationInput;
			editingPlant.Category = plantCategoryInput;
		}
		CloseForms();
	}

	private void OpenPlaceForm()
	{
		placeNameInput = string.Empty;
		placeLightInput = "Bright, filtered";
		placeTemperatureInput = "20–23 °C";
		placeOutdoorInput = false;
		placeFormError = string.Empty;
		showPlaceForm = true;
	}

	private void SavePlace()
	{
		if (string.IsNullOrWhiteSpace(placeNameInput))
		{
			placeFormError = "PlaceNameRequired";
			return;
		}
		if (places.Any(place => place.Name.Equals(placeNameInput.Trim(), StringComparison.OrdinalIgnoreCase)))
		{
			placeFormError = "PlaceNameDuplicate";
			return;
		}
		places.Add(new Place(placeNameInput.Trim(), placeLightInput, placeTemperatureInput, placeOutdoorInput, string.Empty));
		CloseForms();
	}

	private void OpenJournalForm()
	{
		journalTypeInput = "Watered";
		journalPlantInput = plants.FirstOrDefault(plant => plant.Name == "Monstera")?.Name ?? plants[0].Name;
		journalNoteInput = string.Empty;
		journalPhotoData = string.Empty;
		journalPhotoName = string.Empty;
		photoError = string.Empty;
		journalFormError = string.Empty;
		showJournalForm = true;
	}

	private async Task HandlePhotoSelected(InputFileChangeEventArgs eventArgs)
	{
		var file = eventArgs.File;
		journalPhotoData = string.Empty;
		journalPhotoName = string.Empty;
		if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
		{
			photoError = "ChooseImage";
			return;
		}

		try
		{
			await using var stream = file.OpenReadStream(5 * 1024 * 1024);
			using var buffer = new MemoryStream();
			await stream.CopyToAsync(buffer);
			journalPhotoData = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
			journalPhotoName = file.Name;
			photoError = string.Empty;
		}
		catch (IOException)
		{
			photoError = "ChooseSmallImage";
		}
	}

	private void SaveJournalEntry()
	{
		if (string.IsNullOrWhiteSpace(journalPlantInput))
		{
			journalFormError = "JournalPlantRequired";
			return;
		}
		var titleKey = "Journal" + journalTypeInput + "Title";
		var note = string.IsNullOrWhiteSpace(journalNoteInput) ? null : journalNoteInput.Trim();
		journalEntries.Insert(0, new JournalEntry(titleKey, titleKey, journalTypeInput, null, DateTime.UtcNow.Ticks, journalPlantInput, journalPhotoData, note));
		CloseForms();
	}

	private void CloseForms()
	{
		showPlantForm = false;
		showPlaceForm = false;
		showJournalForm = false;
		editingPlant = null;
	}

