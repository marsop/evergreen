	private sealed class Plant(string name, string species, string location, string category, string waterAmount, string light, string image, bool isSelected = false)
	{
		public string Name { get; set; } = name;
		public string Species { get; set; } = species;
		public string Location { get; set; } = location;
		public string Category { get; set; } = category;
		public string WaterAmount { get; set; } = waterAmount;
		public string Light { get; set; } = light;
		public string Image { get; set; } = image;
		public bool IsSelected { get; set; } = isSelected;
		public bool Watered { get; set; }
	}

	private sealed record Place(string Name, string Light, string Temperature, bool Outdoor, string Note);
	private sealed record JournalEntry(string Title, string Description, string Type, string DateLabel, long SortOrder, string PlantName = "", string PhotoData = "");
}
