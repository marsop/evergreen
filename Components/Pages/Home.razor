@page "/"
@inherits LocalizedComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject PlantCatalogService PlantCatalog
@inject GardenStorageService GardenStorage
@inject IJSRuntime JS
<PageTitle>@T("PlantCareTitle")</PageTitle>

@if (loading)
{
	<div class="app-shell"><main class="main-area"><section class="view-content" role="status">@T("LoadingPlants")</section></main></div>
}
else if (loadError is not null)
{
	<main class="view-content">
		<LanguageSelector />
		<h1>@T("GardenRecovery")</h1>
		<p role="alert">@T(loadError)</p>
		<button class="button button-dark" @onclick="LoadGardenAsync">@T("GardenRetry")</button>
		@if (loadError is "GardenInvalid" or "GardenUnsupported")
		{
			@if (!confirmReset)
			{
				<button class="button button-quiet" @onclick="() => confirmReset = true">@T("GardenReset")</button>
			}
			else
			{
				<p>@T("GardenResetConfirm")</p>
				<button class="button button-dark" @onclick="ResetGardenAsync">@T("GardenReset")</button>
				<button class="button button-quiet" @onclick="() => confirmReset = false">@T("Cancel")</button>
			}
		}
		@if (saveError.Length > 0) { <p class="form-error" role="alert">@T(saveError)</p> }
	</main>
}
else
{
<fieldset class="garden-controls" disabled="@(saving || photoProcessing)">
<div class="app-shell">
	<aside class="sidebar" aria-label="@T("MainNavigation")">
		<a class="brand" href="@DestinationUrl("Today")" @onclick='() => Navigate("Today")' @onclick:preventDefault aria-label="@T("EvergreenHome")">
			<span class="brand-mark"><AppIcon Name="@IconName.Leaf" /></span>
			<span><strong>Evergreen</strong><small>@T("BrandTagline")</small></span>
		</a>

		<div class="nav-label">@T("YourGarden")</div>
		<nav class="primary-nav">
			@foreach (var item in NavigationItems)
			{
				<button class="nav-item @(IsCurrent(item.Name) ? "active" : "")" @onclick="() => Navigate(item.Name)">
					<span class="nav-icon"><AppIcon Name="@item.Icon" /></span>
					<span>@T(item.Name)</span>
					@if (item.Name == "Today")
					{
						<span class="nav-count">@DueCount</span>
					}
				</button>
			}
		</nav>

		<div class="sidebar-bottom">
			<div class="season-card">
				<span class="season-mark"><AppIcon Name="@IconName.Sparkle" /></span>
				<div><strong>@T("WinterRhythm")</strong><span>@T("WinterFeed")</span></div>
			</div>
			<div class="sidebar-foot"><span class="status-dot"></span> @T("GardenCounts", CountLabel("PlantCount", plants.Count), CountLabel("PlaceCount", places.Count))</div>
		</div>
	</aside>

	<main class="main-area">
		<header class="topbar">
			<div class="breadcrumbs"><span>@T("YourGarden")</span><span class="crumb-separator">/</span><strong>@CurrentTitle</strong></div>
			<div class="topbar-actions">
				<span class="today-date">@SampleToday.ToString(T("DashboardDateFormat"), Cultures.Culture)</span>
				<LanguageSelector />
				<button class="button button-dark" disabled="@(plants.Count == 0)" @onclick="OpenJournalForm"><AppIcon Name="@IconName.Plus" /> @T("LogCare")</button>
			</div>
		</header>

		@if (activeView == "Today")
		{
			<section class="view-content today-view">
				<div class="today-heading">
					<div>
						<p class="eyebrow">@SampleToday.ToString(T("DashboardDateFormat"), Cultures.Culture).ToUpper(Cultures.Culture) <span class="eyebrow-dot"></span> @T("WateringDay")</p>
						<h1>@T("TodayHeading")</h1>
						<p class="lead">@T("TodayLead")</p>
					</div>
					<div class="day-progress" aria-label="@T("WateringProgress", WateredCount, plants.Count)">
						<div class="progress-ring"><span>@WateredCount<small>/@plants.Count</small></span></div>
						<span>@T("WateredToday")</span>
					</div>
				</div>

				<div class="today-banner">
					<div class="banner-icon"><AppIcon Name="@IconName.Sparkle" /></div>
					<div><strong>@T("WinterRhythm")</strong><span>@T("WinterFertilizing")</span></div>
					<span class="banner-note">@T("SeasonRoutine")</span>
				</div>

				<div class="section-heading task-heading">
					<div><p class="eyebrow">@T("CareList")</p><h2>@CountLabel("ThingsToday", DueCount)</h2></div>
					<div class="task-heading-actions">
						<button class="button button-dark" disabled="@(WateredCount == plants.Count)" @onclick="WaterEverything">@T("WaterEverything")</button>
						<button class="text-button" @onclick='() => Navigate("Plants")'>@T("ViewAllPlants") <AppIcon Name="@IconName.ArrowRight" /></button>
					</div>
				</div>

				<div class="task-locations">
					@foreach (var locationGroup in plants.GroupBy(plant => plant.Location))
					{
						<section class="task-location">
							<div class="location-heading"><span class="location-pin"><AppIcon Name="@IconName.Pin" /></span><h3>@locationGroup.Key</h3><span>@CountLabel("PlantCount", locationGroup.Count())</span></div>
							<div class="task-list">
								@foreach (var plant in locationGroup)
								{
									<article class="task-row @(plant.Watered ? "is-watered" : "")">
										<button class="task-plant" @onclick="() => OpenPlant(plant)" aria-label="@T("OpenPlantProfile", PlantName(plant))">
											<span class="plant-thumb small-thumb">
												<img src="@PlantImages.DisplaySource(plant.Image)" alt="" />
											</span>
											<span class="task-copy"><strong>@PlantName(plant)</strong><small>@T("WaterSchedule", PlantWaterAmount(plant))</small></span>
										</button>
										<button class="water-button @(plant.Watered ? "done" : "")" @onclick="() => ToggleWater(plant)" aria-label="@T(plant.Watered ? "UndoWatering" : "MarkWatered", PlantName(plant))">
											<AppIcon Name="@(plant.Watered ? IconName.Check : IconName.Water)" /> @T(plant.Watered ? "Watered" : "Water")
										</button>
									</article>
								}
							</div>
						</section>
					}
				</div>

				<section class="week-strip">
					<div class="section-heading"><div><p class="eyebrow">@T("AheadOfYou")</p><h2>@T("NextSevenDays")</h2></div><span class="muted-copy">@T("WeekPreview")</span></div>
					<div class="week-days">
						@foreach (var day in WeekDays)
						{
							<div class="week-day @(day.Day == DayOfWeek.Sunday ? "current" : "")"><span>@Cultures.Culture.DateTimeFormat.GetAbbreviatedDayName(day.Day)</span><strong>@day.Count</strong></div>
						}
					</div>
				</section>
			</section>
		}
		else if (activeView == "Plants")
		{
			<section class="view-content">
				<div class="page-heading">
					<div><p class="eyebrow">@T("YourCollection")</p><h1>@T("Plants") <span class="heading-count">@plants.Count</span></h1><p class="lead">@T("PlantsLead")</p></div>
					<button class="button button-dark" disabled="@(places.Count == 0)" @onclick="OpenPlantForm"><AppIcon Name="@IconName.Plus" /> @T("AddPlant")</button>
				</div>
				@if (places.Count == 0) { <p role="status">@T("GardenNeedsPlace")</p> }
				<div class="toolbar">
					<label class="search-box"><AppIcon Name="@IconName.Search" /><input aria-label="@T("SearchPlants")" placeholder="@CountLabel("SearchPlantCount", plants.Count)" @bind="searchTerm" @bind:event="oninput" /></label>
					<div class="filter-row" role="group" aria-label="@T("FilterByPlace")">
						@foreach (var placeName in new[] { "All" }.Concat(places.Select(place => place.Name)))
						{
							<button class="filter-chip @(selectedLocation == placeName ? "selected" : "")" @onclick="() => selectedLocation = placeName">@(placeName == "All" ? T("All") : placeName)</button>
						}
					</div>
				</div>
				@if (!FilteredPlants.Any())
				{
					<div class="empty-state"><span aria-hidden="true">✿</span><h2>@T("NoPlantsFound")</h2><p>@T("TryDifferentSearch")</p></div>
				}
				else
				{
					<div class="plant-groups">
						@foreach (var group in FilteredPlants.GroupBy(plant => plant.Category).OrderBy(group => CategoryOrder.IndexOf(group.Key)))
						{
							<section class="plant-group">
								<div class="group-title"><h2>@T(group.Key)</h2><span>@group.Count().ToString("00", Cultures.Culture)</span></div>
								<div class="plant-list">
									@foreach (var plant in group)
									{
										<button class="plant-list-row" @onclick="() => OpenPlant(plant)">
											<span class="plant-thumb">
												<img src="@PlantImages.DisplaySource(plant.Image)" alt="" />
											</span>
											<span class="plant-name"><strong>@PlantName(plant)</strong><small>@plant.Location</small></span>
											<span class="sun-label"><AppIcon Name="@IconName.Sun" /> @PlantLight(plant)</span>
											<span class="row-arrow"><AppIcon Name="@IconName.ArrowRight" /></span>
										</button>
									}
								</div>
							</section>
						}
					</div>
				}
			</section>
		}
		else if (activeView == "Places")
		{
			<section class="view-content">
				<div class="page-heading">
					<div><p class="eyebrow">@T("LightMakesHome")</p><h1>@T("Places")</h1><p class="lead">@T("PlacesLead")</p></div>
					<button class="button button-dark" @onclick="OpenPlaceForm"><AppIcon Name="@IconName.Plus" /> @T("AddPlace")</button>
				</div>
				<h2 class="subsection-title">@T("Indoor") <span>@CountLabel("SpotCount", places.Count(place => !place.Outdoor))</span></h2>
				<div class="place-grid">
					@foreach (var place in places.Where(place => !place.Outdoor))
					{
						<article class="place-entry">
							<button class="place-card" @onclick="() => ShowPlacePlants(place.Name)">
								<div class="place-card-top"><span class="place-symbol"><AppIcon Name="@IconName.Home" /></span><span class="plant-count">@CountLabel("PlantCount", plants.Count(plant => plant.Location == place.Name))</span></div>
								<h3>@place.Name</h3>
								<div class="place-facts"><span><AppIcon Name="@IconName.Sun" /> @T(place.Light)</span><span><AppIcon Name="@IconName.Thermometer" /> @PlaceTemperature(place)</span></div>
								<div class="place-leaves">
									@foreach (var plant in plants.Where(plant => plant.Location == place.Name).Take(4))
									{
										<span class="plant-thumb mini-thumb"><img src="@PlantImages.DisplaySource(plant.Image)" alt="" /></span>
									}
								</div>
								@if (!string.IsNullOrWhiteSpace(PlaceNote(place))) { <p class="place-note">@PlaceNote(place)</p> }
							</button>
							<button type="button" class="place-edit-action" aria-label="@T("EditPlace")" @onclick="() => OpenEditPlaceForm(place)">@T("EditPlace")</button>
							<button type="button" class="place-delete-action" aria-label="@T("DeletePlace")" title="@(PlaceHasPlants(place) ? T("PlaceHasPlants") : null)" disabled="@PlaceHasPlants(place)" @onclick="() => OpenDeletePlaceConfirmation(place)">@T("DeletePlace")</button>
							@if (PlaceHasPlants(place)) { <span class="place-delete-help">@T("PlaceHasPlants")</span> }
						</article>
					}
				</div>
				<h2 class="subsection-title outdoor-title">@T("Outdoor") <span>@T("LetWeatherIn")</span></h2>
				<div class="outdoor-row">
					@foreach (var place in places.Where(place => place.Outdoor))
					{
						<article class="place-entry">
							<button class="place-card outdoor-card" @onclick="() => ShowPlacePlants(place.Name)">
								<div class="place-card-top"><span class="place-symbol"><AppIcon Name="@IconName.Sun" /></span><span class="plant-count">@CountLabel("PlantCount", plants.Count(plant => plant.Location == place.Name))</span></div>
								<h3>@place.Name</h3><div class="place-facts"><span><AppIcon Name="@IconName.Sun" /> @T(place.Light)</span><span><AppIcon Name="@IconName.Thermometer" /> @PlaceTemperature(place)</span></div>
								@if (!string.IsNullOrWhiteSpace(PlaceNote(place))) { <p class="place-note">@PlaceNote(place)</p> }
							</button>
							<button type="button" class="place-edit-action" aria-label="@T("EditPlace")" @onclick="() => OpenEditPlaceForm(place)">@T("EditPlace")</button>
							<button type="button" class="place-delete-action" aria-label="@T("DeletePlace")" title="@(PlaceHasPlants(place) ? T("PlaceHasPlants") : null)" disabled="@PlaceHasPlants(place)" @onclick="() => OpenDeletePlaceConfirmation(place)">@T("DeletePlace")</button>
							@if (PlaceHasPlants(place)) { <span class="place-delete-help">@T("PlaceHasPlants")</span> }
						</article>
					}
				</div>
			</section>
		}
		else if (activeView == "Journal")
		{
			<section class="view-content">
				<div class="page-heading">
					<div><p class="eyebrow">@T("NotesFromGarden")</p><h1>@T("Journal")</h1><p class="lead">@T("JournalLead")</p></div>
				</div>
				<div class="journal-filters" role="group" aria-label="@T("FilterJournal")">
					@foreach (var entryType in JournalTypes)
					{
						<button class="journal-filter @(selectedJournalType == entryType ? "selected" : "")" @onclick="() => SetJournalFilter(entryType)">
							<AppIcon Name="@JournalIcon(entryType)" />@T(entryType)
						</button>
					}
					<button class="journal-filter @(selectedJournalType == "All" ? "selected" : "")" @onclick='() => selectedJournalType = "All"'>@T("All")</button>
				</div>
				<div class="journal-timeline">
					@foreach (var day in FilteredJournal.GroupBy(entry => entry.Date))
					{
						<section class="journal-day"><h2>@JournalDate(day.Key)</h2>
							@foreach (var entry in day)
							{
								<article class="journal-entry"><span class="journal-entry-icon"><AppIcon Name="@JournalIcon(entry.Type)" /></span><div><strong>@JournalTitle(entry)</strong><p>@JournalDescription(entry)</p>@if (!string.IsNullOrWhiteSpace(entry.PhotoData)) { <img class="journal-photo" src="@entry.PhotoData" alt="@T("JournalAttachment")" /> }</div><time>@T(entry.Type)</time></article>
							}
						</section>
					}
					@if (!FilteredJournal.Any()) { <div class="empty-state"><span aria-hidden="true">✿</span><h2>@T("FreshPage")</h2><p>@T("CareNotesHere")</p></div> }
				</div>
			</section>
		}
		else if (selectedPlant is not null)
		{
			<section class="view-content profile-view">
				<div class="profile-back-row"><button class="back-button" @onclick='() => Navigate("Plants")'><AppIcon Name="@IconName.ArrowLeft" /><span>@T("BackToPlants")</span></button><button class="text-button" @onclick="OpenEditPlantForm">@T("EditPlant") <AppIcon Name="@IconName.ArrowRight" /></button></div>
				<div class="profile-hero">
					<div class="profile-photo">
						<img src="@PlantImages.DisplaySource(selectedPlant.Image)" alt="@selectedPlant.Species" />
					</div>
					<div class="profile-title"><p class="eyebrow">@selectedPlant.Location <span class="eyebrow-dot"></span> @T(selectedPlant.Category)</p><h1>@PlantName(selectedPlant)</h1><p class="species">@selectedPlant.Species</p><span class="profile-alert"><AppIcon Name="@IconName.Alert" /><span>@CareText(selectedPlant.Care.ProfileAlert)</span></span></div>
				</div>
				<section class="care-chart"><div class="care-chart-head"><div><p class="eyebrow">@T("SeasonalCare")</p><h2>@T("CareThroughYear")</h2></div><div class="chart-legend"><span><i class="legend-water"></i>@T("Water")</span><span><i class="legend-feed"></i>@T("Fertilize")</span></div></div><div class="month-chart">
					@foreach (var month in selectedPlant.Care.Months)
					{
						<div class="month-column"><span class="month-bar water-bar" style="--bar: @(month.Water)" title="@T("WaterAmountTooltip", month.Water)"></span><span class="month-bar feed-bar" style="--bar: @(month.Fertilizer)" title="@T("FertilizerTooltip", month.Fertilizer)"></span><small title="@Cultures.Culture.DateTimeFormat.GetMonthName(month.Month)">@Cultures.Culture.DateTimeFormat.GetAbbreviatedMonthName(month.Month)</small></div>
					}
				</div></section>
				<div class="profile-details">
					<section class="care-cards">
						@foreach (var care in CareDetails)
						{
							var detail = selectedPlant.Care.Details[care.Key];
							<article class="care-card"><span class="care-icon"><AppIcon Name="@care.Icon" /></span><div><div class="care-card-title"><h3>@T(care.Title)</h3><strong>@CareText(detail.Value)</strong></div><p>@CareText(detail.Advice)</p></div></article>
						}
					</section>
					<aside class="watchout-panel"><p class="eyebrow">@T("ThingsToWatch")</p><h2>@T("WatchOutFor")</h2><ul>
						@foreach (var watchout in selectedPlant.Care.Watchouts)
						{
							<li><strong>@CareText(watchout.Title)</strong><span>@CareText(watchout.Advice)</span></li>
						}
					</ul></aside>
				</div>
				<section class="profile-history"><div class="section-heading"><div><p class="eyebrow">@T("LifeLogged")</p><h2>@T("RecentHistory")</h2></div><button class="text-button" @onclick='() => Navigate("Journal")'>@T("OpenJournal") <AppIcon Name="@IconName.ArrowRight" /></button></div>
					@foreach (var entry in journalEntries.Where(entry => entry.WateredPlant?.Id == selectedPlant.Id).Take(4))
					{
						<div class="history-row"><span class="journal-entry-icon"><AppIcon Name="@JournalIcon(entry.Type)" /></span><strong>@JournalTitle(entry)</strong><time>@JournalDate(entry.Date)</time></div>
					}
				</section>
			</section>
		}
		else if (activeView == "Profile")
		{
			<section class="view-content">
				<h1>@T("PlantUnavailable")</h1>
				<p role="status">@T("PlantUnavailableDescription")</p>
				<button class="back-button" @onclick='() => Navigate("Plants")'><AppIcon Name="@IconName.ArrowLeft" />@T("BackToPlants")</button>
			</section>
		}
	</main>
</div>

<nav class="mobile-nav" aria-label="@T("MobileNavigation")">
	@foreach (var item in NavigationItems)
	{
		<button class="mobile-nav-item @(IsCurrent(item.Name) ? "active" : "")" @onclick="() => Navigate(item.Name)"><AppIcon Name="@item.Icon" />@T(item.Name)</button>
	}
</nav>

@if (showPlantForm)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="plant-modal-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("YourCollection")</p><h2 id="plant-modal-title">@T(editingPlant is null ? "AddAPlant" : "EditPlant")</h2></div><button class="close-button" aria-label="@T("Close")" @onclick="CloseForms">×</button></div>
			<form novalidate @onsubmit="SavePlant" @onsubmit:preventDefault>
				<label>@T("PlantName")<input required maxlength="60" @bind="plantNameInput" placeholder="@T("PlantNameExample")" /></label>
				<label>@T("BotanicalName")<input maxlength="80" @bind="plantSpeciesInput" placeholder="@T("BotanicalNameExample")" /></label>
				<div class="form-row"><label>@T("Place")<select @bind="plantLocationInput">@foreach (var place in places) { <option value="@place.Name">@place.Name</option> }</select></label><label>@T("CareGroup")<select @bind="plantCategoryInput">@foreach (var category in CategoryOrder) { <option value="@category">@T(category)</option> }</select></label></div>
				@if (plantFormError.Length > 0) { <p class="form-error" role="alert">@T(plantFormError)</p> }
				@if (saveError.Length > 0) { <p class="form-error" role="alert">@T(saveError)</p> }
				<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CloseForms">@T("Cancel")</button><button type="submit" class="button button-dark">@T(editingPlant is null ? "AddPlant" : "SaveChanges")</button></div>
			</form>
		</section>
	</div>
}

@if (showPlaceForm)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="place-modal-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("MakeRoomToGrow")</p><h2 id="place-modal-title">@T(editingPlace is null ? "AddAPlace" : "EditPlace")</h2></div><button class="close-button" aria-label="@T("Close")" @onclick="CloseForms">×</button></div>
			<form novalidate @onsubmit="SavePlace" @onsubmit:preventDefault>
				<label>@T("PlaceName")<input required maxlength="50" @bind="placeNameInput" placeholder="@T("PlaceNameExample")" /></label>
				<div class="form-row"><label>@T("Light")<select @bind="placeLightInput">@foreach (var light in PlaceLights) { <option value="@light">@T(light)</option> }</select></label><label>@T("Temperature")<input maxlength="30" @bind="placeTemperatureInput" placeholder="20–23 °C" /></label></div>
				<label class="check-label"><input type="checkbox" @bind="placeOutdoorInput" /> @T("OutdoorPlace")</label>
				<label>@T("Note")<textarea rows="3" maxlength="240" @bind="placeNoteInput" placeholder="@T("NotePlaceholder")"></textarea></label>
				@if (placeFormError.Length > 0) { <p class="form-error" role="alert">@T(placeFormError)</p> }
				@if (saveError.Length > 0) { <p class="form-error" role="alert">@T(saveError)</p> }
				<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CloseForms">@T("Cancel")</button><button type="submit" class="button button-dark">@T(editingPlace is null ? "AddPlace" : "SaveChanges")</button></div>
			</form>
		</section>
	</div>
}

@if (placePendingDeletion is not null)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="alertdialog" aria-modal="true" aria-labelledby="delete-place-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("MakeRoomToGrow")</p><h2 id="delete-place-title">@T("DeletePlace")</h2></div><button class="close-button" aria-label="@T("Close")" @onclick="CancelDeletePlace">×</button></div>
			<p>@T("ConfirmDeletePlace", placePendingDeletion.Name)</p>
			@if (placeDeleteError.Length > 0) { <p class="form-error" role="alert">@T(placeDeleteError)</p> }
			@if (saveError.Length > 0) { <p class="form-error" role="alert">@T(saveError)</p> }
			<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CancelDeletePlace">@T("Cancel")</button><button type="button" class="button button-dark" @onclick="DeletePlace">@T("DeletePlace")</button></div>
		</section>
	</div>
}

@if (showJournalForm)
{
	<div class="modal-backdrop" role="presentation">
		<section class="modal" role="dialog" aria-modal="true" aria-labelledby="journal-modal-title">
			<div class="modal-heading"><div><p class="eyebrow">@T("MomentInGarden")</p><h2 id="journal-modal-title">@T("LogPlantCare")</h2></div><button class="close-button" aria-label="@T("Close")" @onclick="CloseForms">×</button></div>
			<form @onsubmit="SaveJournalEntry" @onsubmit:preventDefault>
				<label>@T("WhatHappened")<select @bind="journalTypeInput">@foreach (var type in JournalTypes) { <option value="@type">@T(type)</option> }</select></label>
				<label>@T("Plant")<select @bind="journalPlantInput">@foreach (var plant in plants) { <option value="@plant.Id">@PlantName(plant)</option> }</select></label>
				<label>@T("Date")<InputDate @bind-Value="journalDateInput" max="@JournalDateInputMax" required /></label>
				@if (journalTypeInput == "Photo")
				{
					<label class="photo-upload"><span>@T("Photo")</span><span class="file-picker">@T("ChoosePhoto")</span><InputFile class="visually-hidden" aria-label="@T("ChoosePhoto")" accept="image/*" OnChange="HandlePhotoSelected" /><span>@(journalPhotoName.Length > 0 ? journalPhotoName : T("NoPhotoSelected"))</span></label>
					@if (!string.IsNullOrWhiteSpace(photoError)) { <p class="form-error" role="alert">@T(photoError)</p> }
					@if (!string.IsNullOrWhiteSpace(journalPhotoData)) { <img class="photo-preview" src="@journalPhotoData" alt="@T("SelectedJournalPhoto")" /> }
				}
				<label>@T("Note")<textarea rows="3" maxlength="240" @bind="journalNoteInput" placeholder="@T("NotePlaceholder")"></textarea></label>
				@if (journalFormError.Length > 0) { <p class="form-error" role="alert">@T(journalFormError)</p> }
				@if (saveError.Length > 0) { <p class="form-error" role="alert">@T(saveError)</p> }
				<div class="modal-actions"><button type="button" class="button button-quiet" @onclick="CloseForms">@T("Cancel")</button><button type="submit" class="button button-dark">@T("SaveEntry")</button></div>
			</form>
		</section>
	</div>
}
</fieldset>
@if (saveError.Length > 0 && !showPlantForm && !showPlaceForm && !showJournalForm && placePendingDeletion is null)
{
	<div class="garden-storage-message form-error" role="alert">@T(saveError)</div>
}
@if (saving || photoProcessing) { <div class="garden-storage-message" role="status">@T(photoProcessing ? "GardenPhotoProcessing" : "GardenSaving")</div> }
}

@code {
	[SupplyParameterFromQuery(Name = "view")]
	public string? View { get; set; }
	[SupplyParameterFromQuery(Name = "plant")]
	public string? PlantId { get; set; }
	[SupplyParameterFromQuery(Name = "place")]
	public string? PlaceName { get; set; }
	private string? appliedUri;
	private bool loading = true;
	private bool saving;
	private bool photoProcessing;
	private bool confirmReset;
	private string? loadError;
	private string saveError = string.Empty;
	private IReadOnlyList<PlantCatalogEntry> catalog = [];

	private DateOnly today = DateOnly.FromDateTime(DateTime.Now);
	private DateOnly SampleToday => today;
	private Timer? dayTimer;
	private static readonly string[] CategoryOrder = GardenSnapshot.Categories;
	private static readonly string[] JournalTypes = GardenSnapshot.EntryTypes;
	private static readonly string[] PlaceLights = GardenSnapshot.Lights;
	private static readonly (string Name, IconName Icon)[] NavigationItems = [("Today", IconName.Today), ("Plants", IconName.Plants), ("Places", IconName.Places), ("Journal", IconName.Journal)];
	private static readonly (DayOfWeek Day, string Count)[] WeekDays = [(DayOfWeek.Monday, "·"), (DayOfWeek.Tuesday, "·"), (DayOfWeek.Wednesday, "·"), (DayOfWeek.Thursday, "·"), (DayOfWeek.Friday, "·"), (DayOfWeek.Saturday, "·"), (DayOfWeek.Sunday, "23")];
	private static readonly (IconName Icon, string Title, string Key)[] CareDetails =
	[
		(IconName.Sun, "Light", "Light"),
		(IconName.Water, "Water", "Water"),
		(IconName.Fertilizer, "Fertilizer", "Fertilizer"),
		(IconName.Thermometer, "TemperatureHumidity", "TemperatureHumidity"),
		(IconName.Repot, "SubstrateRepotting", "SubstrateRepotting"),
		(IconName.Prune, "Pruning", "Pruning"),
		(IconName.Plants, "Propagation", "Propagation")
	];

	private readonly List<Plant> plants = [];
	private readonly List<Place> places = CreatePlaces();
	private readonly List<JournalEntry> journalEntries = [];
	private string activeView = "Today";
	private string selectedLocation = "All";
	private string selectedJournalType = "All";
	private string searchTerm = string.Empty;
	private Plant? selectedPlant => plants.FirstOrDefault(plant => plant.Id == PlantId);
	private Plant? editingPlant;
	private Place? editingPlace;
	private Place? placePendingDeletion;
	private int DueCount => plants.Count;
	private int WateredCount => plants.Count(plant => plant.Watered);
	private string CurrentTitle => T(activeView == "Profile" ? "PlantProfile" : activeView);
	private IEnumerable<Plant> FilteredPlants => plants
		.Where(plant => selectedLocation == "All" || plant.Location == selectedLocation)
		.Where(plant => PlantName(plant).Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || plant.Species.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
	private IEnumerable<JournalEntry> FilteredJournal => journalEntries
		.Where(entry => selectedJournalType == "All" || entry.Type == selectedJournalType)
		.OrderByDescending(entry => entry.Date ?? SampleToday)
		.ThenByDescending(entry => entry.SortOrder);
	private bool showPlantForm;
	private bool showPlaceForm;
	private bool showJournalForm;
	private string plantNameInput = string.Empty;
	private string plantSpeciesInput = string.Empty;
	private string plantLocationInput = "Mos Eisley South";
	private string plantCategoryInput = CategoryOrder[1];
	private string placeNameInput = string.Empty;
	private string placeLightInput = "Bright, filtered";
	private string placeTemperatureInput = "20–23 °C";
	private string placeTemperatureInputOriginal = string.Empty;
	private bool placeOutdoorInput;
	private string placeNoteInput = string.Empty;
	private string placeNoteInputOriginal = string.Empty;
	private string journalTypeInput = "Watered";
	private string journalPlantInput = "sample-3";
	private string journalNoteInput = string.Empty;
	private DateOnly journalDateInput = DateOnly.FromDateTime(DateTime.Now);
	private string journalPhotoData = string.Empty;
	private string journalPhotoName = string.Empty;
	private string photoError = string.Empty;
	private string plantFormError = string.Empty;
	private string placeFormError = string.Empty;
	private string placeDeleteError = string.Empty;
	private string journalFormError = string.Empty;

	private string CountLabel(string key, int count) => T(key + (count == 1 ? "One" : "Many"), count);
	private string JournalDate(DateOnly? date) => date is null || date == SampleToday ? T("Today") : date.Value.ToString(T("JournalDateFormat"), Cultures.Culture);
	private string JournalDateInputMax => SampleToday.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);
	private string PlantName(Plant plant) => plant.Name.Length > 0
		? plant.Name
		: plant.Catalog is null ? string.Empty : PlantCatalogService.LocalizedValue(plant.Catalog.Name, Cultures.Culture);
	private string PlantLight(Plant plant) => plant.Catalog is null
		? T(plant.Light)
		: CareText(plant.Care.Details["Light"].Value);
	private string PlantWaterAmount(Plant plant) => plant.Catalog is null
		? T(plant.WaterAmount)
		: CareText(plant.Care.Details["Water"].Amount!);
	private string CareText(IReadOnlyDictionary<string, string> values) => PlantCatalogService.LocalizedValue(values, Cultures.Culture);
	private string JournalPlantName(JournalEntry entry) => entry.WateredPlant is null ? entry.PlantName : PlantName(entry.WateredPlant);
	private string JournalTitle(JournalEntry entry) => T(entry.TitleKey, JournalPlantName(entry));
	private string JournalDescription(JournalEntry entry) => entry.UserNote
		?? (entry.DescriptionKey == "WateringDescription"
			? T(entry.DescriptionKey, JournalPlantName(entry), entry.WateredPlant is null ? entry.WaterAmount : PlantWaterAmount(entry.WateredPlant))
			: T(entry.DescriptionKey, JournalPlantName(entry)));
	private string PlaceTemperature(Place place) => place.TemperatureKey is null ? place.Temperature : T(place.TemperatureKey);
	private string PlaceNote(Place place) => place.NoteKey is null ? place.Note : T(place.NoteKey);
	private bool PlaceHasPlants(Place place) => plants.Any(plant => string.Equals(plant.Location, place.Name, StringComparison.Ordinal));

	private bool IsCurrent(string name) => activeView == name || (activeView == "Profile" && name == "Plants");
	private string DestinationUrl(string view, string? plantId = null, string? placeName = null) =>
		Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
		{
			["view"] = view == "Today" ? null : view.ToLowerInvariant(),
			["plant"] = plantId,
			["place"] = placeName
		});

	private void Navigate(string view, string? plantId = null, string? placeName = null, bool replace = false)
	{
		var destination = DestinationUrl(view, plantId, placeName);
		if (!string.Equals(destination, Navigation.Uri, StringComparison.Ordinal))
			Navigation.NavigateTo(destination, replace: replace);
	}

	protected override async Task OnInitializedAsync()
	{
		catalog = await PlantCatalog.LoadAsync();
		await LoadGardenAsync();

		dayTimer = new Timer(_ => _ = InvokeAsync(() =>
		{
			var currentDay = DateOnly.FromDateTime(DateTime.Now);
			if (today == currentDay) return;
			today = currentDay;
			StateHasChanged();
		}), null, TimeSpan.FromMinutes(1), TimeSpan.FromMinutes(1));
	}

	private async Task LoadGardenAsync()
	{
		loading = true;
		saveError = string.Empty;
		var result = await GardenStorage.LoadAsync(catalog);
		loadError = result.Error;
		if (loadError is null)
		{
			if (result.Snapshot is not null)
				ApplySnapshot(result.Snapshot);
			else
			{
				plants.Clear();
				plants.AddRange(catalog.Select(entry => new Plant(entry)));
				places.Clear();
				places.AddRange(CreatePlaces());
				journalEntries.Clear();
			}
			appliedUri = null;
			OnParametersSet();
		}
		confirmReset = false;
		loading = false;
	}

	private async Task ResetGardenAsync()
	{
		if (await GardenStorage.ResetAsync())
			await LoadGardenAsync();
		else
			saveError = "GardenResetFailed";
	}

	private GardenSnapshot CaptureSnapshot() => new()
	{
		Plants = plants.Select(plant => new GardenPlant
		{
			Id = plant.Id, CatalogId = plant.Catalog?.Id, CareCatalogId = plant.CareCatalogId,
			Name = plant.Name, Species = plant.Species, Location = plant.Location, Category = plant.Category,
			Image = plant.Image, WaterAmount = plant.WaterAmount, Light = plant.Light, WateredOn = plant.WateredOn
		}).ToList(),
		Places = places.Select(place => new GardenPlace(place.Name, place.Light, place.Temperature, place.Outdoor,
			place.Note, place.TemperatureKey, place.NoteKey)).ToList(),
		Entries = journalEntries.Select(entry => new GardenEntry(entry.TitleKey, entry.DescriptionKey, entry.Type,
			entry.Date ?? SampleToday, entry.SortOrder, entry.WateredPlant!.Id, entry.PhotoData,
			entry.UserNote, entry.AutomaticWatering)).ToList()
	};

	private void ApplySnapshot(GardenSnapshot snapshot)
	{
		plants.Clear();
		foreach (var saved in snapshot.Plants)
		{
			var source = catalog.First(item => item.Id == (saved.CatalogId ?? saved.CareCatalogId));
			var plant = saved.CatalogId is not null ? new Plant(source) :
				new Plant(saved.Name, saved.Species, saved.Location, saved.Category, saved.WaterAmount, saved.Light, saved.Image, source.Care);
			plant.Id = saved.Id;
			plant.CareCatalogId = source.Id;
			plant.Name = saved.Name;
			plant.Species = saved.Species;
			plant.Location = saved.Location;
			plant.Category = saved.Category;
			plant.Image = saved.Image;
			plant.WaterAmount = saved.WaterAmount;
			plant.Light = saved.Light;
			plant.WateredOn = saved.WateredOn;
			plants.Add(plant);
		}
		places.Clear();
		places.AddRange(snapshot.Places.Select(place => new Place(place.Name, place.Light, place.Temperature,
			place.Outdoor, place.Note, place.TemperatureKey, place.NoteKey)));
		journalEntries.Clear();
		journalEntries.AddRange(snapshot.Entries.Select(entry => new JournalEntry(entry.TitleKey, entry.DescriptionKey,
			entry.Type, entry.Date, entry.SortOrder, PhotoData: entry.PhotoData, UserNote: entry.UserNote,
			WateredPlant: plants.First(plant => plant.Id == entry.PlantId), AutomaticWatering: entry.AutomaticWatering)));
	}

	private async Task<bool> CommitAsync(Action<GardenSnapshot> change)
	{
		if (saving || photoProcessing || loadError is not null) return false;
		saving = true;
		saveError = string.Empty;
		try
		{
			var candidate = CaptureSnapshot();
			change(candidate);
			if (!await GardenStorage.SaveAsync(candidate, catalog))
			{
				saveError = "GardenSaveFailed";
				return false;
			}
			ApplySnapshot(candidate);
			return true;
		}
		finally
		{
			saving = false;
		}
	}

	public void Dispose() => dayTimer?.Dispose();

	protected override void OnParametersSet()
	{
		if (appliedUri == Navigation.Uri) return;
		appliedUri = Navigation.Uri;
		CloseForms();
		activeView = View switch
		{
			null or "" or "today" => "Today",
			"plants" => "Plants",
			"places" => "Places",
			"journal" => "Journal",
			"profile" => "Profile",
			_ => "Today"
		};
		selectedLocation = activeView == "Plants" && PlaceName is not null && places.Any(place => place.Name == PlaceName)
			? PlaceName : "All";
		if (View is not (null or "" or "today" or "plants" or "places" or "journal" or "profile"))
			Navigate("Today", replace: true);
	}
	private void SetJournalFilter(string entryType) => selectedJournalType = selectedJournalType == entryType ? "All" : entryType;

	private void OpenPlant(Plant plant)
	{
		Navigate("Profile", plantId: plant.Id);
	}

	private void ShowPlacePlants(string placeName)
	{
		Navigate("Plants", placeName: placeName);
	}

	private async Task ToggleWater(Plant plant)
	{
		await CommitAsync(candidate =>
		{
			var saved = candidate.Plants.First(item => item.Id == plant.Id);
			if (saved.WateredOn == SampleToday)
			{
				saved.WateredOn = null;
				candidate.Entries.RemoveAll(entry => entry.AutomaticWatering && entry.PlantId == plant.Id && entry.Date == SampleToday);
			}
			else
				WaterPlant(candidate, saved);
		});
	}

	private void WaterPlant(GardenSnapshot candidate, GardenPlant plant)
	{
		plant.WateredOn = SampleToday;
		candidate.Entries.Insert(0, new GardenEntry("JournalWateredTitle", "WateringDescription", "Watered",
			SampleToday, DateTime.UtcNow.Ticks, plant.Id, AutomaticWatering: true));
	}

	private async Task WaterEverything() => await CommitAsync(candidate =>
	{
		foreach (var plant in candidate.Plants.Where(plant => plant.WateredOn != SampleToday))
			WaterPlant(candidate, plant);
	});

	private void OpenPlantForm()
	{
		saveError = string.Empty;
		editingPlant = null;
		plantNameInput = string.Empty;
		plantSpeciesInput = string.Empty;
		plantLocationInput = places.FirstOrDefault(place => !place.Outdoor)?.Name ?? places.First().Name;
		plantCategoryInput = CategoryOrder[1];
		plantFormError = string.Empty;
		showPlantForm = true;
	}

	private void OpenEditPlantForm()
	{
		saveError = string.Empty;
		if (selectedPlant is null) return;
		editingPlant = selectedPlant;
		plantNameInput = PlantName(selectedPlant);
		plantSpeciesInput = selectedPlant.Species;
		plantLocationInput = selectedPlant.Location;
		plantCategoryInput = selectedPlant.Category;
		plantFormError = string.Empty;
		showPlantForm = true;
	}

	private async Task SavePlant()
	{
		if (string.IsNullOrWhiteSpace(plantNameInput))
		{
			plantFormError = "PlantNameRequired";
			return;
		}
		if (await CommitAsync(candidate =>
		{
			var saved = editingPlant is null ? new GardenPlant
			{
				Id = Guid.NewGuid().ToString("N"), CareCatalogId = catalog[0].Id,
				WaterAmount = "Normal", Light = "Bright"
			} : candidate.Plants.First(plant => plant.Id == editingPlant.Id);
			saved.Name = plantNameInput.Trim();
			saved.Species = string.IsNullOrWhiteSpace(plantSpeciesInput) ? saved.Name : plantSpeciesInput.Trim();
			saved.Location = plantLocationInput;
			saved.Category = plantCategoryInput;
			if (editingPlant is null) candidate.Plants.Add(saved);
		}))
			CloseForms();
	}

	private void OpenPlaceForm()
	{
		saveError = string.Empty;
		editingPlace = null;
		placeNameInput = string.Empty;
		placeLightInput = "Bright, filtered";
		placeTemperatureInput = "20–23 °C";
		placeTemperatureInputOriginal = string.Empty;
		placeOutdoorInput = false;
		placeNoteInput = string.Empty;
		placeNoteInputOriginal = string.Empty;
		placeFormError = string.Empty;
		showPlaceForm = true;
	}

	private void OpenEditPlaceForm(Place place)
	{
		saveError = string.Empty;
		editingPlace = place;
		placeNameInput = place.Name;
		placeLightInput = place.Light;
		placeTemperatureInput = PlaceTemperature(place);
		placeTemperatureInputOriginal = placeTemperatureInput;
		placeOutdoorInput = place.Outdoor;
		placeNoteInput = PlaceNote(place);
		placeNoteInputOriginal = placeNoteInput;
		placeFormError = string.Empty;
		showPlaceForm = true;
	}

	private void OpenDeletePlaceConfirmation(Place place)
	{
		saveError = string.Empty;
		if (!places.Contains(place) || PlaceHasPlants(place)) return;
		placeDeleteError = string.Empty;
		placePendingDeletion = place;
	}

	private void CancelDeletePlace()
	{
		saveError = string.Empty;
		placePendingDeletion = null;
		placeDeleteError = string.Empty;
	}

	private async Task DeletePlace()
	{
		if (placePendingDeletion is null) return;
		if (PlaceHasPlants(placePendingDeletion))
		{
			placeDeleteError = "PlaceHasPlants";
			return;
		}

		if (await CommitAsync(candidate => candidate.Places.RemoveAll(place => place.Name == placePendingDeletion.Name)))
			CancelDeletePlace();
	}

	private async Task SavePlace()
	{
		var name = placeNameInput.Trim();
		if (name.Length == 0)
		{
			placeFormError = "PlaceNameRequired";
			return;
		}
		if (places.Any(place => !ReferenceEquals(place, editingPlace) && place.Name.Equals(name, StringComparison.OrdinalIgnoreCase)))
		{
			placeFormError = "PlaceNameDuplicate";
			return;
		}

		if (await CommitAsync(candidate =>
		{
			if (editingPlace is null)
			{
				candidate.Places.Add(new GardenPlace(name, placeLightInput, placeTemperatureInput.Trim(), placeOutdoorInput, placeNoteInput.Trim()));
				return;
			}
			var index = candidate.Places.FindIndex(place => place.Name == editingPlace.Name);
			var editedPlace = candidate.Places[index];
			var temperatureUnchanged = placeTemperatureInput.Trim() == placeTemperatureInputOriginal;
			var noteUnchanged = placeNoteInput.Trim() == placeNoteInputOriginal;
			candidate.Places[index] = editedPlace with
			{
				Name = name,
				Light = placeLightInput,
				Temperature = temperatureUnchanged ? editedPlace.Temperature : placeTemperatureInput.Trim(),
				TemperatureKey = temperatureUnchanged ? editedPlace.TemperatureKey : null,
				Outdoor = placeOutdoorInput,
				Note = noteUnchanged ? editedPlace.Note : placeNoteInput.Trim(),
				NoteKey = noteUnchanged ? editedPlace.NoteKey : null
			};
			if (!string.Equals(editedPlace.Name, name, StringComparison.Ordinal))
			{
				foreach (var plant in candidate.Plants.Where(plant => string.Equals(plant.Location, editedPlace.Name, StringComparison.Ordinal)))
					plant.Location = name;
			}
		}))
			CloseForms();
	}

	private void OpenJournalForm()
	{
		saveError = string.Empty;
		journalTypeInput = "Watered";
		journalPlantInput = plants.FirstOrDefault(plant => plant.Catalog?.Id == "sample-3") is { } monstera
			? monstera.Id
			: plants[0].Id;
		journalNoteInput = string.Empty;
		journalDateInput = SampleToday;
		journalPhotoData = string.Empty;
		journalPhotoName = string.Empty;
		photoError = string.Empty;
		journalFormError = string.Empty;
		showJournalForm = true;
	}

	private async Task HandlePhotoSelected(InputFileChangeEventArgs eventArgs)
	{
		var file = eventArgs.File;
		photoProcessing = true;
		journalPhotoData = string.Empty;
		journalPhotoName = string.Empty;
		if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
		{
			photoError = "ChooseImage";
			photoProcessing = false;
			return;
		}

		try
		{
			await using var stream = file.OpenReadStream(5 * 1024 * 1024);
			using var buffer = new MemoryStream();
			await stream.CopyToAsync(buffer);
			journalPhotoData = await JS.InvokeAsync<string>("evergreenGarden.compressPhoto",
				$"data:{file.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}");
			journalPhotoName = file.Name;
			photoError = string.Empty;
		}
		catch (IOException)
		{
			photoError = "ChooseSmallImage";
		}
		catch (JSException)
		{
			photoError = "GardenPhotoFailed";
		}
		finally
		{
			photoProcessing = false;
		}
	}

	private async Task SaveJournalEntry()
	{
		if (photoProcessing || (journalTypeInput == "Photo" && photoError.Length > 0)) return;
		var journalPlant = plants.FirstOrDefault(plant => plant.Id == journalPlantInput);
		if (journalPlant is null)
		{
			journalFormError = "JournalPlantRequired";
			return;
		}
		if (journalDateInput > SampleToday)
		{
			journalFormError = "JournalDateCannotBeFuture";
			return;
		}
		var titleKey = "Journal" + journalTypeInput + "Title";
		var note = string.IsNullOrWhiteSpace(journalNoteInput) ? null : journalNoteInput.Trim();
		if (await CommitAsync(candidate => candidate.Entries.Insert(0, new GardenEntry(titleKey, titleKey,
			journalTypeInput, journalDateInput, DateTime.UtcNow.Ticks, journalPlant.Id,
			journalTypeInput == "Photo" ? journalPhotoData : string.Empty, note))))
			CloseForms();
	}

	private void CloseForms()
	{
		showPlantForm = false;
		showPlaceForm = false;
		showJournalForm = false;
		editingPlant = null;
		editingPlace = null;
		saveError = string.Empty;
	}

	private static IconName JournalIcon(string type) => type switch
	{
		"Watered" => IconName.Water,
		"Fertilized" => IconName.Fertilizer,
		"Repotted" => IconName.Repot,
		"Pruned" => IconName.Prune,
		"Treated" => IconName.Treatment,
		"Photo" => IconName.Photo,
		_ => IconName.Leaf
	};

	private static List<Place> CreatePlaces() =>
	[
		new("Mos Eisley South", "Bright, filtered", "20–23 °C", false, string.Empty),
		new("Mos Eisley West", "Direct afternoon sun", "20–23 °C", false, string.Empty),
		new("Panopticon", "Full sun", "Winter 5–12 °C", false, string.Empty, "WinterTemperature", "PanopticonAdvice"),
		new("Sweatshop", "Low light", "20–22 °C", false, string.Empty),
		new("Garden", "Full sun to shade", "Outdoor", true, string.Empty, "Outdoor")
	];

	private sealed class Plant
	{
		public Plant(PlantCatalogEntry catalog)
		{
			Catalog = catalog;
			Id = catalog.Id;
			Species = catalog.Species;
			Location = catalog.Location;
			Category = catalog.Category;
			Image = catalog.Image;
			Care = catalog.Care;
		}

		public Plant(string name, string species, string location, string category, string waterAmount, string light, string image, PlantCareProfile care)
		{
			Name = name;
			Species = species;
			Location = location;
			Category = category;
			WaterAmount = waterAmount;
			Light = light;
			Image = image;
			Care = care;
			Id = Guid.NewGuid().ToString("N");
		}

		public PlantCatalogEntry? Catalog { get; }
		public PlantCareProfile Care { get; }
		public string Id { get; set; }
		public string? CareCatalogId { get; set; }
		public string Name { get; set; } = string.Empty;
		public string Species { get; set; } = string.Empty;
		public string Location { get; set; } = string.Empty;
		public string Category { get; set; } = string.Empty;
		public string WaterAmount { get; set; } = string.Empty;
		public string Light { get; set; } = string.Empty;
		public string Image { get; set; } = string.Empty;
		public DateOnly? WateredOn { get; set; }
		public bool Watered => WateredOn == DateOnly.FromDateTime(DateTime.Now);
	}

	private sealed record Place(string Name, string Light, string Temperature, bool Outdoor, string Note, string? TemperatureKey = null, string? NoteKey = null);
	private sealed record JournalEntry(string TitleKey, string DescriptionKey, string Type, DateOnly? Date, long SortOrder, string PlantName = "", string PhotoData = "", string? UserNote = null, Plant? WateredPlant = null, string WaterAmount = "", bool AutomaticWatering = false);
}
