@inherits LayoutComponentBase
@inject LocalizationService Cultures
@inject IStringLocalizer<AppResources> Localizer

@Body

<div id="blazor-error-ui" data-nosnippet>
    <span data-localization="error">@T("UnexpectedError")</span>
    <a href="." class="reload" data-localization="reload">@T("Reload")</a>
    <button type="button" class="dismiss" data-localization="dismiss" title="@T("Dismiss")" aria-label="@T("Dismiss")">🗙</button>
</div>

@code {
    [CascadingParameter] public CultureInfo SelectedCulture { get; set; } = CultureInfo.GetCultureInfo("en");
    private string T(string key) => Cultures.Translate(Localizer, key);
}
